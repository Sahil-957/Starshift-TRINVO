# Storefront → admin connection. Leave both empty and the site shows
# "Checkout opens soon" with its built-in catalogue.
# Admin → TINVO → Settings → Storefront tokens.
ADMIN_API_URL=
STOREFRONT_TOKEN=

# Server only: the public address (PayU returns customers here), and the key the
# admin's "Publish to storefront" button uses (deploy hook: <SITE_URL>/api/publish?key=…)
SITE_URL=
PUBLISH_KEY=
PUBLISH_TRIGGER=/var/lib/tinvo/publish.request

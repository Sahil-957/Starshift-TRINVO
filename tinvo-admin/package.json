{
  "name": "tinvo-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mts",
    "owner:create": "node --env-file-if-exists=.env.local scripts/owner-create.mts",
    "test": "node --env-file-if-exists=.env.local --test src/**/*.test.ts",
    "neon:check": "node --env-file-if-exists=.env.local scripts/neon-check.mts",
    "qikink:check": "node --env-file-if-exists=.env.local scripts/qikink-check.mts",
    "qikink:test": "node --env-file-if-exists=.env.local scripts/qikink-sandbox-test.mts",
    "print-files:upload": "node --env-file-if-exists=.env.local scripts/print-files-upload.mts",
    "catalogue:import": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/catalogue-import.mts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@neon/config": "^1.10.1",
    "@vercel/functions": "^3.10.6",
    "bcryptjs": "3.0.2",
    "drizzle-orm": "0.44.6",
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}

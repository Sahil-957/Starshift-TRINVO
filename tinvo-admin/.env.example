# Copy to .env.local. Never commit .env.local.

# --- Neon (written by `neon checkout <branch>` / `neon env pull`; don't fill by hand)
# DATABASE_URL, DATABASE_URL_UNPOOLED   owner role: migrations only (bypasses RLS)
# NEON_BRANCH
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_ENDPOINT_URL_S3, AWS_REGION

# --- App database role (row-level security applies). For the current branch:
#   neon connection-string <branch> --role-name tinvo_app --pooled
APP_DATABASE_URL=

# --- Auth.js. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
AUTH_TRUST_HOST=true

# --- Qikink: dashboard.qikink.com -> Integration -> Custom API
QIKINK_CLIENT_ID=
# the secret differs between sandbox and live
QIKINK_CLIENT_SECRET=
# sandbox (default) or live
QIKINK_ENV=sandbox

# --- Encrypts per-shop secrets (Razorpay, Qikink keys). 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it safe: losing it means re-entering every shop's keys.
CREDENTIALS_KEY=

# --- Vercel Cron sends this as a Bearer token to /api/cron/sync
CRON_SECRET=
